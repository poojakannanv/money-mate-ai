# Supabase Postgres connection string.
# Use the "Transaction" pooler URI from Supabase (port 6543) for serverless,
# and append ?sslmode=require if it is not already present.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-eu-west-2.pooler.supabase.com:6543/postgres"

# Auth.js secret. Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# Resend API key for magic-link emails (https://resend.com)
AUTH_RESEND_KEY="re_xxxxxxxxxxxxxxxx"

# The "from" address for magic-link emails. On the Resend free tier you can
# use onboarding@resend.dev while testing.
EMAIL_FROM="MoneyMate AI <onboarding@resend.dev>"

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxx"

# Optional model overrides
# ANTHROPIC_CHAT_MODEL="claude-sonnet-4-5"
# ANTHROPIC_FAST_MODEL="claude-3-5-haiku-latest"
