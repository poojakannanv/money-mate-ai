# Supabase Postgres connection string.
# Use the "Transaction" pooler URI from Supabase (port 6543) for serverless,
# and append ?sslmode=require if it is not already present.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-eu-west-2.pooler.supabase.com:6543/postgres"

# Auth.js secret. Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# Resend API key for magic-link emails (https://resend.com)
AUTH_RESEND_KEY="re_xxxxxxxxxxxxxxxx"

# The "from" address for magic-link emails. On the Resend free tier you can
# use onboarding@resend.dev while testing.
EMAIL_FROM="MoneyMate AI <onboarding@resend.dev>"

# AI provider. Set ONE of the keys below. If several are set, the first in
# this order wins: Groq, Gemini, Anthropic. Force one with AI_PROVIDER.
# With no key at all the app still works: merchant rules categorise
# transactions and the weekly digest is computed, but chat is disabled.

# Groq, free tier (https://console.groq.com/keys)
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxx"

# Google Gemini, free tier (https://aistudio.google.com/apikey)
# GEMINI_API_KEY="xxxxxxxxxxxxxxxx"

# Anthropic Claude, pay as you go (https://console.anthropic.com)
# ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxx"

# Optional overrides
# AI_PROVIDER="groq"            # groq | gemini | anthropic
# AI_CHAT_MODEL="openai/gpt-oss-120b"
# AI_FAST_MODEL="openai/gpt-oss-20b"
# CATEGORISER="ai"              # send every row to the model, skipping merchant rules
